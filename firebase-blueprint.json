{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pelajar UtamaGo! termasuk identitas akun, jenis kelamin maskot, dan level JLPT.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_.]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "gender": {
          "type": "string",
          "enum": ["cowok", "cewek"]
        },
        "selfAssessedLevel": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"]
        },
        "targetLevel": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"]
        },
        "dailyMinutes": {
          "type": "number"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "email",
        "name",
        "gender",
        "selfAssessedLevel",
        "targetLevel",
        "dailyMinutes",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Pemetaan username unik ke UID dan email untuk login berbasis username.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "AnkiDeckState": {
      "title": "AnkiDeckState",
      "description": "Pengaturan independen, kuota harian, urutan kartu baru harian, dan sesi aktif untuk satu dari 10 deck Anki milik pengguna.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deckId": {
          "type": "string",
          "enum": [
            "N5",
            "N4",
            "N3",
            "N2",
            "N1",
            "N5_BUNPOU",
            "N4_BUNPOU",
            "N3_BUNPOU",
            "N2_BUNPOU",
            "N1_BUNPOU"
          ]
        },
        "category": {
          "type": "string",
          "enum": ["kosakata", "bunpou"]
        },
        "jlptLevel": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"]
        },
        "settings": {
          "type": "object",
          "properties": {
            "dailyNewLimit": { "type": "number" },
            "maxReviewsPerDay": { "type": "number" },
            "targetRetention": { "type": "number" },
            "learningStepsMinutes": { "type": "array", "items": { "type": "number" } },
            "relearningStepsMinutes": { "type": "array", "items": { "type": "number" } },
            "newCardOrder": { "type": "string", "enum": ["random", "sequential"] },
            "reviewCardOrder": { "type": "string", "enum": ["oldest_due", "random"] },
            "resumeInterruptedSession": { "type": "boolean" }
          },
          "required": [
            "dailyNewLimit",
            "maxReviewsPerDay",
            "targetRetention",
            "learningStepsMinutes",
            "relearningStepsMinutes",
            "newCardOrder",
            "reviewCardOrder",
            "resumeInterruptedSession"
          ]
        },
        "daily": {
          "type": "object",
          "properties": {
            "dateKey": { "type": "string", "minLength": 10, "maxLength": 10 },
            "newCardIdsToday": { "type": "array", "items": { "type": "string" } },
            "reviewedCardIdsToday": { "type": "array", "items": { "type": "string" } },
            "reviewCompletionsToday": { "type": "number" },
            "extraReviewQuotaToday": { "type": "number" },
            "dailyNewOrderDateKey": { "type": "string", "maxLength": 10 },
            "dailyNewOrderIds": { "type": "array", "items": { "type": "string" } }
          },
          "required": [
            "dateKey",
            "newCardIdsToday",
            "reviewedCardIdsToday",
            "reviewCompletionsToday",
            "extraReviewQuotaToday",
            "dailyNewOrderDateKey",
            "dailyNewOrderIds"
          ]
        },
        "activeSession": {
          "type": ["object", "null"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "deckId",
        "category",
        "jlptLevel",
        "settings",
        "daily",
        "activeSession",
        "updatedAt"
      ]
    },
    "AnkiCardProgress": {
      "title": "AnkiCardProgress",
      "description": "Status SM-2, jadwal jatuh tempo, langkah learning/relearning, status Mastered, dan riwayat review untuk satu kartu milik pengguna.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deckId": {
          "type": "string",
          "enum": [
            "N5",
            "N4",
            "N3",
            "N2",
            "N1",
            "N5_BUNPOU",
            "N4_BUNPOU",
            "N3_BUNPOU",
            "N2_BUNPOU",
            "N1_BUNPOU"
          ]
        },
        "category": {
          "type": "string",
          "enum": ["kosakata", "bunpou"]
        },
        "jlptLevel": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"]
        },
        "state": {
          "type": "string",
          "enum": ["new", "learning", "review", "relearning", "suspended"]
        },
        "previousStateBeforeSuspend": {
          "type": "string",
          "enum": ["", "new", "learning", "review", "relearning"]
        },
        "easeFactor": { "type": "number" },
        "intervalDays": { "type": "number" },
        "repetitions": { "type": "number" },
        "lapses": { "type": "number" },
        "learningStepIndex": { "type": "number" },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "dueAt": { "type": "number" },
        "lastReviewedAt": { "type": "string", "maxLength": 40 },
        "lastRating": {
          "type": "string",
          "enum": ["again", "hard", "good", "easy"]
        },
        "isMastered": { "type": "boolean" },
        "reviewHistory": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "cardId",
        "deckId",
        "category",
        "jlptLevel",
        "state",
        "previousStateBeforeSuspend",
        "easeFactor",
        "intervalDays",
        "repetitions",
        "lapses",
        "learningStepIndex",
        "dueDate",
        "dueAt",
        "lastReviewedAt",
        "lastRating",
        "isMastered",
        "reviewHistory",
        "updatedAt"
      ]
    },
    "BetaFeedback": {
      "title": "BetaFeedback",
      "description": "Laporan bug, typo materi, dan saran fitur dari Beta Tester UtamaGo!.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_.]+$"
        },
        "category": {
          "type": "string",
          "enum": ["bug", "typo", "suggestion", "other"]
        },
        "screen": {
          "type": "string",
          "enum": ["home", "anki", "learn", "challenge", "tryout", "profile", "other"]
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["open", "reviewed", "resolved"]
        },
        "adminNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "jlptLevel": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"]
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "screenshotDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 260000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "username",
        "category",
        "screen",
        "title",
        "description",
        "status",
        "adminNote",
        "jlptLevel",
        "appVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Penanda akun pengelola resmi UtamaGo! yang berwenang meninjau laporan Beta Tester.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Dokumen profil pribadi per pengguna terautentikasi."
    },
    "/users/{userId}/ankiDecks/{deckId}": {
      "schema": { "$ref": "#/entities/AnkiDeckState" },
      "description": "Pengaturan independen, kuota harian, dan sesi aktif untuk 10 deck Anki milik pengguna."
    },
    "/users/{userId}/ankiCards/{cardDocId}": {
      "schema": { "$ref": "#/entities/AnkiCardProgress" },
      "description": "Status SRS SM-2 dan riwayat review per kartu Anki milik pengguna."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameLookup" },
      "description": "Dokumen lookup tunggal per username unik (tanpa izin list)."
    },
    "/betaFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/BetaFeedback" },
      "description": "Laporan bug, typo materi, dan saran dari Beta Tester UtamaGo!."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Daftar UID admin terpercaya (read-only bagi pemilik UID)."
    }
  }
}
